<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Ensure we don't loop internally on /out/
  # But we must catch direct external requests to /out/ first

  # Redirect direct external requests to /out/index.html to homepage
  RewriteCond %{THE_REQUEST} \s/out/index\.html(\?.*)?\s [NC]
  RewriteRule ^out/index\.html$ https://www.gamewheelclub.com/ [R=301,L]

  # Redirect direct external requests to /out/.../index.html to clean URL
  RewriteCond %{THE_REQUEST} \s/out/([^?\s]*)/index\.html(\?.*)?\s [NC]
  RewriteRule ^out/(.*)/index\.html$ https://www.gamewheelclub.com/$1/ [R=301,L]

  # Redirect any other direct external requests to /out/... to clean URL
  RewriteCond %{THE_REQUEST} \s/out/([^?\s]+)\s [NC]
  RewriteRule ^out/(.*)$ https://www.gamewheelclub.com/$1 [R=301,L]

  # --- Specific Legacy Route Redirects ---
  RewriteRule ^hu/timer/?$ https://www.gamewheelclub.com/timer/ [R=301,L]

  # --- Unified Canonicalization Rules ---
  
  # 1. Non-file requests (no extension) missing trailing slash, or on HTTP, or on non-www
  # Redirect to HTTPS + www + path + trailing slash in one single hop
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,4}$
  RewriteCond %{REQUEST_URI} !^/out/
  RewriteRule ^(.*)$ https://www.gamewheelclub.com/$1/ [R=301,L]

  # 2. Requests that already have a trailing slash (or are files), but are on HTTP or non-www
  # Redirect to HTTPS + www in one single hop
  RewriteCond %{REQUEST_URI} !^/out/
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\.gamewheelclub\.com$ [NC]
  RewriteRule ^(.*)$ https://www.gamewheelclub.com/$1 [R=301,L]

  # --- Internal Next.js Rewrites ---

  # Check if the requested file exists inside the /out directory
  RewriteCond %{REQUEST_URI} !^/out/
  RewriteCond %{DOCUMENT_ROOT}/out/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/out/$1 -d
  RewriteRule ^(.*)$ /out/$1 [L]
  
  # Fallback for clean URLs (routes without .html extension)
  RewriteCond %{REQUEST_URI} !^/out/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /out/$1.html [L]
</IfModule>
