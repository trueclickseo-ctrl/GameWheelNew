<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Redirect direct external requests to /out/... to their clean canonical equivalent
  # A. For assets (images, CSS, JS, etc.) - strip /out/ but preserve no-trailing-slash
  RewriteCond %{THE_REQUEST} \s/out/([^?\s]+\.(?:png|jpg|jpeg|gif|svg|ico|css|js|json|xml|txt|webmanifest|woff|woff2|mp3|wav)) [NC]
  RewriteRule ^out/(.*)$ https://www.gamewheelclub.com/$1 [R=301,L,NE]

  # B. For /out/index.html or /out/index - redirect to homepage root /
  RewriteCond %{THE_REQUEST} \s/out/index(?:\.html)? [NC]
  RewriteRule ^out/index(?:\.html)?$ https://www.gamewheelclub.com/ [R=301,L,NE]

  # C. For page paths/HTML - strip /out/ and .html, and standardize with a trailing slash
  RewriteCond %{THE_REQUEST} \s/out/ [NC]
  RewriteRule ^out/(.*?)/?(?:\.html)?$ https://www.gamewheelclub.com/$1/ [R=301,L,NE]

  # 2. Redirect to HTTPS + WWW + Trailing Slash if trailing slash is missing (and not a physical file/asset/html)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\.gamewheelclub\.com$ [NC,OR]
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|svg|ico|json|xml|txt|webmanifest|woff|woff2|mp3|wav|html)$ [NC]
  RewriteRule ^(.*?[^/])$ https://www.gamewheelclub.com/$1/ [R=301,L]

  # 3. Redirect to HTTPS + WWW if trailing slash is present, but protocol or host is wrong
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\.gamewheelclub\.com$ [NC]
  RewriteCond %{REQUEST_URI} /$
  RewriteRule ^(.*)$ https://www.gamewheelclub.com/$1 [R=301,L]

  # 4. Internal rewrites (clean URL routing to the physical static export directory)
  # Ensure we don't loop indefinitely
  RewriteCond %{REQUEST_URI} !^/out/
  
  # Check if the requested file exists inside the /out directory
  RewriteCond %{DOCUMENT_ROOT}/out/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/out/$1 -d
  RewriteRule ^(.*)$ /out/$1 [L]
  
  # Fallback for clean URLs (routes without .html extension)
  RewriteCond %{REQUEST_URI} !^/out/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /out/$1.html [L]
</IfModule>

# Enable Gzip / Brotli Compression for Performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# Leverage Browser Caching for Static Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security & Performance Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
